* text=auto

# Unity YAML: merge as text, keep LF
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.meta       text eol=lf
*.controller text eol=lf
*.anim       text eol=lf
*.cs         text eol=lf
*.shader     text eol=lf
*.cginc      text eol=lf
*.asmdef     text eol=lf
*.md         text eol=lf
*.py         text eol=lf

# Binary art
*.fbx    binary
*.blend  binary
*.png    binary
*.jpg    binary
*.webp   binary
*.wav    binary
*.ogg    binary
