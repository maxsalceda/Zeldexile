<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast compile of the pure domain (no Unity) : dotnet build Tools/DomainCheck -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(TEMP)\zx-domaincheck\obj\</BaseIntermediateOutputPath>
    <OutputPath>$(TEMP)\zx-domaincheck\bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Zeldexile\Assets\Zeldexile\Scripts\Domain\*.cs" />
  </ItemGroup>
</Project>
